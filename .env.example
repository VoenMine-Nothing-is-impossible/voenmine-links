# --- Домен / публичный адрес ---
DOMAIN=links.example.com
PUBLIC_BASE_URL=https://links.example.com
APP_PORT=8096

# --- Backend ---
SECRET_KEY=change-me-to-64-random-chars-minimum-0123456789abcdef0123456789ab
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PAID_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL ---
POSTGRES_USER=links
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=links
DATABASE_URL=postgresql+psycopg2://links:change-me-strong-password@postgres:5432/links

# --- Redis (кэш редиректов, счётчики, rate-limit) ---
REDIS_URL=redis://redis:6379/0

# --- Лимиты ---
RATE_CREATE_PER_MIN=30
RATE_REDIRECT_PER_MIN=120
DEFAULT_SLUG_LEN=7

# --- YooKassa (рублёвые платежи за переход) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://links.example.com/
YOOKASSA_MOCK=true

# --- Хранилище файлов (QR) ---
DATA_DIR=/data
QR_DIR=/data/qr

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://links.example.com
FRONTEND_PORT=8097
